<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The radius the launcher itself rounds a widget to. Overridden on API 31+
      with the platform's own value (values-v31), so the corners baked into the
      glass bitmap land exactly where the host's clip does instead of leaving a
      sliver of square image outside a rounder mask. 28dp is the pre-31
      stand-in, where hosts don't clip at all and the baked corners are the only
      ones there are.

      Each card's own radius is at or below this one, so a host that clips
      rounder simply trims a corner that was already transparent.
    -->
    <dimen name="widget_corner_radius">28dp</dimen>

    <!-- The 1.5dp crystal rim stroked round every face. -->
    <dimen name="widget_glass_rim">1.5dp</dimen>

    <!-- The 2×2 card and the vinyl card: the reference's 26dp corner. -->
    <dimen name="widget_card_radius">26dp</dimen>

    <!-- The 4×1 capsule's 24dp corner. -->
    <dimen name="widget_pill_radius">24dp</dimen>

    <!--
      The 2×2 square card: a 64dp tile with the track beside it, the wave and
      seek bar stacked across the middle, and the three transport bubbles in one
      centred row along the foot.
    -->
    <dimen name="widget_card_padding">10dp</dimen>
    <dimen name="widget_card_art">64dp</dimen>
    <dimen name="widget_card_art_corner">12dp</dimen>
    <dimen name="widget_card_art_rim">1dp</dimen>
    <dimen name="widget_card_gap">10dp</dimen>
    <dimen name="widget_card_wave_height">10dp</dimen>
    <dimen name="widget_card_wave_gap">6dp</dimen>
    <dimen name="widget_card_seek_height">4dp</dimen>
    <dimen name="widget_card_seek_gap">2dp</dimen>
    <!--
      The row is exactly the play bubble's height, and 36 + 6 + 40 + 6 + 36 is
      the 124dp the three keys take: the card's own inner width at two cells is
      never smaller than that once the host lays the layout out at its real
      width (the options bundle reports the 70n − 30 cell minimum, not the
      cell's own width).
    -->
    <dimen name="widget_card_transport">40dp</dimen>
    <dimen name="widget_card_transport_gap">6dp</dimen>
    <dimen name="widget_card_transport_top">6dp</dimen>
    <dimen name="widget_card_prev">36dp</dimen>
    <dimen name="widget_card_play">40dp</dimen>

    <!--
      The 4×1 capsule: a 54dp tile and the track on the left, the three bubble
      keys on the right. The capsule fills whatever height the host gives it,
      inset by [widget_pill_margin] top and bottom.
    -->
    <dimen name="widget_pill_margin">4dp</dimen>
    <dimen name="widget_pill_art">54dp</dimen>
    <dimen name="widget_pill_art_corner">14dp</dimen>
    <dimen name="widget_pill_art_rim">1dp</dimen>
    <dimen name="widget_pill_padding_h">12dp</dimen>
    <dimen name="widget_pill_gap">12dp</dimen>
    <dimen name="widget_pill_wave_height">12dp</dimen>
    <dimen name="widget_pill_wave_width">64dp</dimen>
    <dimen name="widget_pill_wave_gap">2dp</dimen>
    <dimen name="widget_pill_transport">48dp</dimen>
    <dimen name="widget_pill_prev">40dp</dimen>
    <dimen name="widget_pill_play">48dp</dimen>
    <dimen name="widget_pill_button_gap">8dp</dimen>

    <!--
      The 3×3 vinyl card: a circular disc inside two glowing rings, centred
      title and artist, the wave and seek bar, and the three transport bubbles.
    -->
    <dimen name="widget_vinyl_padding">10dp</dimen>
    <dimen name="widget_vinyl_disc_rim">1.2dp</dimen>
    <dimen name="widget_vinyl_wave_height">16dp</dimen>
    <dimen name="widget_vinyl_seek_height">6dp</dimen>
    <dimen name="widget_vinyl_transport">54dp</dimen>
    <dimen name="widget_vinyl_prev">44dp</dimen>
    <dimen name="widget_vinyl_play">54dp</dimen>
    <!--
      8dp, not 12: 44 + 8 + 54 + 8 + 44 is 158dp, which fits the 160dp inside the
      card's 10dp padding at the 180dp three-cell minimum. At 12dp the row was
      166dp and would have been trimmed by the card's clip.
    -->
    <dimen name="widget_vinyl_button_gap">8dp</dimen>
</resources>
