<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The radius the launcher itself rounds a widget to. Overridden on API 31+
      with the platform's own value (values-v31), so the corners baked into the
      glass bitmap land exactly where the host's clip does instead of leaving a
      sliver of square image outside a rounder mask. 28dp is the pre-31
      stand-in, where hosts don't clip at all and the baked corners are the only
      ones there are.

      Each card's own radius is at or below this one, so a host that clips
      rounder simply trims a corner that was already transparent.
    -->
    <dimen name="widget_corner_radius">28dp</dimen>

    <!-- The 1.5dp crystal rim stroked round every face. -->
    <dimen name="widget_glass_rim">1.5dp</dimen>

    <!-- The 2×2 card and the vinyl card: the reference's 26dp corner. -->
    <dimen name="widget_card_radius">26dp</dimen>

    <!-- The 4×2 card, and the 4×1 capsule's 24dp corner. -->
    <dimen name="widget_wide_radius">28dp</dimen>
    <dimen name="widget_pill_radius">24dp</dimen>

    <!--
      The 2×2 square card: 12dp of padding, a 52dp tile in the top-left, the
      equalizer and seek bar across the middle and the transport pinned to the
      foot, with Shuffle and Repeat in the two bottom corners.
    -->
    <dimen name="widget_card_padding">12dp</dimen>
    <dimen name="widget_card_art">52dp</dimen>
    <dimen name="widget_card_art_corner">12dp</dimen>
    <dimen name="widget_card_art_rim">1dp</dimen>
    <dimen name="widget_card_gap">10dp</dimen>
    <dimen name="widget_card_wave_height">18dp</dimen>
    <dimen name="widget_card_seek_height">6dp</dimen>
    <dimen name="widget_card_transport">34dp</dimen>
    <dimen name="widget_card_key">20dp</dimen>
    <dimen name="widget_card_prev">24dp</dimen>
    <dimen name="widget_card_play">30dp</dimen>
    <dimen name="widget_card_transport_gap">4dp</dimen>
    <dimen name="widget_card_transport_inset">52dp</dimen>

    <!--
      The 4×2 card: a 104dp tile beside the deck, the full-width 28dp crystal
      ribbon along the foot.
    -->
    <dimen name="widget_wide_padding">14dp</dimen>
    <dimen name="widget_wide_gap">14dp</dimen>
    <dimen name="widget_wide_art">104dp</dimen>
    <dimen name="widget_wide_art_corner">18dp</dimen>
    <dimen name="widget_wide_art_rim">1.2dp</dimen>
    <dimen name="widget_wide_key">22dp</dimen>
    <dimen name="widget_wide_prev">36dp</dimen>
    <dimen name="widget_wide_play">44dp</dimen>
    <dimen name="widget_wide_transport">44dp</dimen>
    <dimen name="widget_wide_button_gap">10dp</dimen>
    <dimen name="widget_wide_progress_row">18dp</dimen>
    <dimen name="widget_wide_seek_height">8dp</dimen>
    <dimen name="widget_wide_wave_height">28dp</dimen>

    <!--
      The 4×1 capsule: 58dp tile, a 92dp-tall glass body, and the track split
      into title row, progress row and control row.
    -->
    <dimen name="widget_pill_height">92dp</dimen>
    <dimen name="widget_pill_art">58dp</dimen>
    <dimen name="widget_pill_art_corner">14dp</dimen>
    <dimen name="widget_pill_art_rim">1dp</dimen>
    <dimen name="widget_pill_padding_h">12dp</dimen>
    <dimen name="widget_pill_padding_v">6dp</dimen>
    <dimen name="widget_pill_gap">12dp</dimen>
    <dimen name="widget_pill_key">20dp</dimen>
    <dimen name="widget_pill_prev">26dp</dimen>
    <dimen name="widget_pill_play">34dp</dimen>
    <dimen name="widget_pill_transport">30dp</dimen>
    <dimen name="widget_pill_button_gap">5dp</dimen>
    <dimen name="widget_pill_seek_height">6dp</dimen>
    <dimen name="widget_pill_wave_width">64dp</dimen>
    <dimen name="widget_pill_wave_height">12dp</dimen>

    <!--
      The 3×3 vinyl card: a circular disc inside two glowing rings, centred
      title and artist, the wave and seek bar, and five bubble keys.
    -->
    <dimen name="widget_vinyl_padding">14dp</dimen>
    <dimen name="widget_vinyl_disc">200dp</dimen>
    <dimen name="widget_vinyl_disc_rim">1.2dp</dimen>
    <dimen name="widget_vinyl_wave_height">16dp</dimen>
    <dimen name="widget_vinyl_seek_height">6dp</dimen>
    <dimen name="widget_vinyl_key">20dp</dimen>
    <dimen name="widget_vinyl_prev">28dp</dimen>
    <dimen name="widget_vinyl_play">36dp</dimen>
    <dimen name="widget_vinyl_transport">38dp</dimen>
    <dimen name="widget_vinyl_button_gap">4dp</dimen>
</resources>
