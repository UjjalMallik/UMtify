<?xml version="1.0" encoding="utf-8"?>
<!--
  Stand-in for the 4×2 artwork tile before the composite arrives, and in the
  picker. A vector rather than a shape because it sits in an adjustViewBounds
  ImageView: the intrinsic 112dp square is what holds the tile 1:1 before the
  real bitmap is pushed in.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="112dp"
    android:height="112dp"
    android:viewportWidth="112"
    android:viewportHeight="112">

    <path android:pathData="M18,0 L94,0 A18,18 0 0 1 112,18 L112,94 A18,18 0 0 1 94,112 L18,112 A18,18 0 0 1 0,94 L0,18 A18,18 0 0 1 18,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="0"
                android:endY="112"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item android:color="#FF39405A" android:offset="0" />
                <item android:color="#FF222A3C" android:offset="0.5" />
                <item android:color="#FF0C1018" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <path
        android:fillColor="#00FFFFFF"
        android:pathData="M18,0 L94,0 A18,18 0 0 1 112,18 L112,94 A18,18 0 0 1 94,112 L18,112 A18,18 0 0 1 0,94 L0,18 A18,18 0 0 1 18,0 Z"
        android:strokeColor="#4DFFFFFF"
        android:strokeWidth="1" />
</vector>
