<?xml version="1.0" encoding="utf-8"?>
<!--
  Stand-in for the 4×2 artwork tile before the composite arrives, and in the
  picker. Same gradient as the glass body so the hole reads as an inset pane of
  the same material rather than a dark rectangle.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/widget_wide_art_corner" />
    <gradient
        android:angle="270"
        android:centerColor="#FF1B2130"
        android:centerY="0.45"
        android:endColor="#FF07090E"
        android:startColor="#FF2E3446"
        android:type="linear" />
</shape>
