<?xml version="1.0" encoding="utf-8"?>
<!--
  A 30dp 3D crystal bubble: the 1.2dp specular rim (white 85% down to 20%
  across the middle and back up to 65% at the foot), the convex dome inside it,
  the wet-gloss crescent across the top and the bounce light along the bottom.
  Sized to the view that uses it so the rim never scales below 1.2dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="30dp"
    android:height="30dp"
    android:viewportWidth="30"
    android:viewportHeight="30">

    <group>
        <clip-path android:pathData="M0,15a15,15 0 1,0 30,0a15,15 0 1,0 -30,0z" />

        <path android:pathData="M0,15a15,15 0 1,0 30,0a15,15 0 1,0 -30,0z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="15"
                    android:centerY="8.4"
                    android:gradientRadius="23.4"
                    android:startColor="#38FFFFFF"
                    android:endColor="#0DFFFFFF" />
            </aapt:attr>
        </path>

        <path android:pathData="M4.2,10.65a10.8,6.15 0 1,0 21.6,0a10.8,6.15 0 1,0 -21.6,0z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="0"
                    android:startY="4.5"
                    android:endX="0"
                    android:endY="16.8"
                    android:startColor="#66FFFFFF"
                    android:endColor="#14FFFFFF" />
            </aapt:attr>
        </path>

        <path android:pathData="M2.4,28.8a12.6,5.1 0 1,0 25.2,0a12.6,5.1 0 1,0 -25.2,0z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="0"
                    android:startY="21.6"
                    android:endX="0"
                    android:endY="30"
                    android:startColor="#00FFFFFF"
                    android:endColor="#40FFFFFF" />
            </aapt:attr>
        </path>
    </group>

    <path
        android:fillType="evenOdd"
        android:pathData="M0,15a15,15 0 1,0 30,0a15,15 0 1,0 -30,0zM1.2,15a13.8,13.8 0 1,0 27.6,0a13.8,13.8 0 1,0 -27.6,0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="30"
                android:startColor="#D9FFFFFF"
                android:centerColor="#33FFFFFF"
                android:endColor="#A6FFFFFF" />
        </aapt:attr>
    </path>
</vector>
