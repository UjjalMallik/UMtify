<?xml version="1.0" encoding="utf-8"?>
<!--
  The 26dp crystal disc the 4×1 capsule's Like, previous, next and Shuffle sit
  in — the same 18% body and 1.5dp diagonal rim as widget_crystal_disc, drawn at
  its own size so the rim stays 1.5dp rather than scaling with the view.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="26dp"
    android:height="26dp"
    android:viewportWidth="26"
    android:viewportHeight="26">

    <path
        android:fillColor="#2EFFFFFF"
        android:pathData="M2.25,13a10.75,10.75 0 1,0 21.5,0a10.75,10.75 0 1,0 -21.5,0z" />

    <path
        android:fillType="evenOdd"
        android:pathData="M0.75,13a12.25,12.25 0 1,0 24.5,0a12.25,12.25 0 1,0 -24.5,0zM2.25,13a10.75,10.75 0 1,0 21.5,0a10.75,10.75 0 1,0 -21.5,0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endColor="#4DFFFFFF"
                android:endX="26"
                android:endY="26"
                android:startColor="#D9FFFFFF"
                android:startX="0"
                android:startY="0"
                android:type="linear" />
        </aapt:attr>
    </path>
</vector>
