    <path android:fillColor="#14FFFFFF" android:pathData="M159,68 A19,19 0 1 0 159,106 A19,19 0 1 0 159,68 Z" android:strokeColor="#3DFFFFFF" android:strokeWidth="1" />
    <group android:scaleX="0.7" android:scaleY="0.7" android:translateX="151" android:translateY="79">
        <path android:pathData="M7,7.4L7,16.6" android:strokeColor="#FFFFFFFF" android:strokeLineCap="round" android:strokeWidth="2.4" />
        <path android:fillColor="#FFFFFFFF" android:pathData="M16.6,7.7L16.6,16.3L10.7,12Z" android:strokeColor="#FFFFFFFF" android:strokeLineCap="round" android:strokeLineJoin="round" android:strokeWidth="2.4" />
    </group>

    <path android:fillColor="#2EFFFFFF" android:pathData="M217,68 L233,68 A19,19 0 0 1 252,87 A19,19 0 0 1 233,106 L217,106 A19,19 0 0 1 198,87 A19,19 0 0 1 217,68 Z" android:strokeColor="#99FFFFFF" android:strokeWidth="1" />
    <group android:scaleX="0.75" android:scaleY="0.75" android:translateX="216" android:translateY="78">
        <path android:fillColor="#FFFFFFFF" android:pathData="M8.4,6.4L8.4,17.6L17.6,12Z" android:strokeColor="#FFFFFFFF" android:strokeLineCap="round" android:strokeLineJoin="round" android:strokeWidth="2.6" />
    </group>

    <path android:fillColor="#14FFFFFF" android:pathData="M291,68 A19,19 0 1 0 291,106 A19,19 0 1 0 291,68 Z" android:strokeColor="#3DFFFFFF" android:strokeWidth="1" />
    <group android:scaleX="0.7" android:scaleY="0.7" android:translateX="283" android:translateY="79">
        <path android:fillColor="#FFFFFFFF" android:pathData="M7.4,7.7L7.4,16.3L13.3,12Z" android:strokeColor="#FFFFFFFF" android:strokeLineCap="round" android:strokeLineJoin="round" android:strokeWidth="2.4" />
        <path android:pathData="M17,7.4L17,16.6" android:strokeColor="#FFFFFFFF" android:strokeLineCap="round" android:strokeWidth="2.4" />
    </group>

    <!-- Elapsed, track, played part, total. -->
    <path android:pathData="M140,120 L153,120" android:strokeColor="#99FFFFFF" android:strokeLineCap="round" android:strokeWidth="5" />
    <path android:pathData="M161,120 L289,120" android:strokeColor="#38FFFFFF" android:strokeLineCap="round" android:strokeWidth="4" />
    <path android:pathData="M161,120 L239,120" android:strokeColor="#E6FFFFFF" android:strokeLineCap="round" android:strokeWidth="4" />
    <path android:pathData="M297,120 L310,120" android:strokeColor="#99FFFFFF" android:strokeLineCap="round" android:strokeWidth="5" />

    <!-- Signature diagonal specular rim. -->
    <path android:fillColor="#00FFFFFF" android:pathData="M28,0 L296,0 A28,28 0 0 1 324,28 L324,112 A28,28 0 0 1 296,140 L28,140 A28,28 0 0 1 0,112 L0,28 A28,28 0 0 1 28,0 Z" android:strokeWidth="1.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="324"
                android:endY="140"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item android:color="#D9FFFFFF" android:offset="0" />
                <item android:color="#40FFFFFF" android:offset="0.5" />
                <item android:color="#B3FFFFFF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
