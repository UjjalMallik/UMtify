<?xml version="1.0" encoding="utf-8"?>
<!--
  Picker artwork for the 4×2 widget on hosts older than API 31. The reference
  card in miniature at its ideal 112dp tile: clear crystal body, inset artwork
  tile on the left, the deck on the right with its crystal Like disc, the
  transport row and the progress bar.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="324dp"
    android:height="140dp"
    android:viewportWidth="324"
    android:viewportHeight="140">

    <!-- Clear body: white 12%. -->
    <path android:pathData="M28,0 L296,0 A28,28 0 0 1 324,28 L324,112 A28,28 0 0 1 296,140 L28,140 A28,28 0 0 1 0,112 L0,28 A28,28 0 0 1 28,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="0"
                android:endY="140"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item android:color="#2BFFFFFF" android:offset="0" />
                <item android:color="#1FFFFFFF" android:offset="0.45" />
                <item android:color="#14FFFFFF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Legibility scrim: black 10%. -->
    <path android:fillColor="#1A000000" android:pathData="M28,0 L296,0 A28,28 0 0 1 324,28 L324,112 A28,28 0 0 1 296,140 L28,140 A28,28 0 0 1 0,112 L0,28 A28,28 0 0 1 28,0 Z" />

    <!-- Wet sheen over the top 35%. -->
    <path android:pathData="M28,0 L296,0 A28,28 0 0 1 324,28 L324,112 A28,28 0 0 1 296,140 L28,140 A28,28 0 0 1 0,112 L0,28 A28,28 0 0 1 28,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="0"
                android:endY="49"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item android:color="#47FFFFFF" android:offset="0" />
                <item android:color="#00FFFFFF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bounce along the last 15%. -->
    <path android:pathData="M28,0 L296,0 A28,28 0 0 1 324,28 L324,112 A28,28 0 0 1 296,140 L28,140 A28,28 0 0 1 0,112 L0,28 A28,28 0 0 1 28,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="0"
                android:endY="140"
                android:startX="0"
                android:startY="119"
                android:type="linear">
                <item android:color="#00FFFFFF" android:offset="0" />
                <item android:color="#24FFFFFF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inset artwork tile. -->
    <path android:pathData="M32,14 L108,14 A18,18 0 0 1 126,32 L126,108 A18,18 0 0 1 108,126 L32,126 A18,18 0 0 1 14,108 L14,32 A18,18 0 0 1 32,14 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="0"
                android:endY="126"
                android:startX="0"
                android:startY="14"
                android:type="linear">
                <item android:color="#FF39405A" android:offset="0" />
                <item android:color="#FF222A3C" android:offset="0.5" />
                <item android:color="#FF0C1018" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:fillColor="#00FFFFFF" android:pathData="M32,14 L108,14 A18,18 0 0 1 126,32 L126,108 A18,18 0 0 1 108,126 L32,126 A18,18 0 0 1 14,108 L14,32 A18,18 0 0 1 32,14 Z" android:strokeColor="#8CFFFFFF" android:strokeWidth="1" />

    <!-- Title and artist. -->
    <path android:pathData="M140,32 L246,32" android:strokeColor="#FFFFFFFF" android:strokeLineCap="round" android:strokeWidth="8" />
    <path android:pathData="M140,50 L212,50" android:strokeColor="#CCFFFFFF" android:strokeLineCap="round" android:strokeWidth="5" />

    <!-- Crystal Like disc, top right. -->
    <path android:fillColor="#2EFFFFFF" android:pathData="M275,36 A17,17 0 1 0 309,36 A17,17 0 1 0 275,36 Z" android:strokeColor="#59FFFFFF" android:strokeWidth="1" />
    <group android:scaleX="0.67" android:scaleY="0.67" android:translateX="284" android:translateY="28">
        <path android:pathData="M12,20C12,20 3.2,14.6 3.2,8.9A4.5,4.5 0 0 1,12 7.4A4.5,4.5 0 0 1,20.8 8.9C20.8,14.6 12,20 12,20Z" android:strokeColor="#FFFFFFFF" android:strokeLineCap="round" android:strokeLineJoin="round" android:strokeWidth="2.4" />
