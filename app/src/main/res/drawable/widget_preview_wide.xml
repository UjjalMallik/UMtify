<?xml version="1.0" encoding="utf-8"?>
<!--
  Picker artwork for the 4×2 widget, on hosts older than API 31. The split card
  in miniature: frosted body, inset artwork tile on the left, the deck on the
  right with its frosted Like disc, the glass play pill and the progress bar.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="250dp"
    android:height="110dp"
    android:viewportWidth="250"
    android:viewportHeight="110">

    <!-- Frosted body. -->
    <path android:pathData="M26,0 L224,0 A26,26 0 0 1 250,26 L250,84 A26,26 0 0 1 224,110 L26,110 A26,26 0 0 1 0,84 L0,26 A26,26 0 0 1 26,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="0"
                android:endY="110"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item android:color="#FF2E3446" android:offset="0" />
                <item android:color="#FF1B2130" android:offset="0.45" />
                <item android:color="#FF07090E" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Wet-glass sheen over the top 40%. -->
    <path android:pathData="M26,0 L224,0 A26,26 0 0 1 250,26 L250,84 A26,26 0 0 1 224,110 L26,110 A26,26 0 0 1 0,84 L0,26 A26,26 0 0 1 26,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="0"
                android:endY="44"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item android:color="#38FFFFFF" android:offset="0" />
                <item android:color="#00FFFFFF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inset artwork tile, with its 1dp glass edge. -->
    <path android:pathData="M32,14 L78,14 A18,18 0 0 1 96,32 L96,78 A18,18 0 0 1 78,96 L32,96 A18,18 0 0 1 14,78 L14,32 A18,18 0 0 1 32,14 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="0"
                android:endY="96"
                android:startX="0"
                android:startY="14"
                android:type="linear">
                <item android:color="#FF39405A" android:offset="0" />
                <item android:color="#FF222A3C" android:offset="0.5" />
                <item android:color="#FF0C1018" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
    <path android:fillColor="#00FFFFFF" android:pathData="M32,14 L78,14 A18,18 0 0 1 96,32 L96,78 A18,18 0 0 1 78,96 L32,96 A18,18 0 0 1 14,78 L14,32 A18,18 0 0 1 32,14 Z" android:strokeColor="#4DFFFFFF" android:strokeWidth="1" />

    <!-- Title and artist. -->
    <path android:pathData="M110,26 L196,26" android:strokeColor="#FFFFFFFF" android:strokeLineCap="round" android:strokeWidth="7" />
    <path android:pathData="M110,41 L172,41" android:strokeColor="#B8FFFFFF" android:strokeLineCap="round" android:strokeWidth="5" />

    <!-- Frosted Like disc, top right. -->
    <path android:fillColor="#2EFFFFFF" android:pathData="M226,10 A17,17 0 1 0 226,44 A17,17 0 1 0 226,10 Z" android:strokeColor="#59FFFFFF" android:strokeWidth="1" />
    <group android:translateX="218" android:translateY="19" android:scaleX="0.67" android:scaleY="0.67">
        <path android:pathData="M12,20C12,20 3.2,14.6 3.2,8.9A4.5,4.5 0 0 1,12 7.4A4.5,4.5 0 0 1,20.8 8.9C20.8,14.6 12,20 12,20Z" android:strokeColor="#FFFFFFFF" android:strokeLineCap="round" android:strokeLineJoin="round" android:strokeWidth="2.4" />
    </group>

    <!-- The glowing glass play pill, with previous and next either side. -->
    <path android:fillColor="#33FFFFFF" android:pathData="M174,48 L190,48 A14,14 0 0 1 204,62 A14,14 0 0 1 190,76 L174,76 A14,14 0 0 1 160,62 A14,14 0 0 1 174,48 Z" android:strokeColor="#66FFFFFF" android:strokeWidth="1" />
    <group android:translateX="172" android:translateY="55" android:scaleX="0.6" android:scaleY="0.6">
        <path android:fillColor="#FFFFFFFF" android:pathData="M8.4,6.4L8.4,17.6L17.6,12Z" android:strokeColor="#FFFFFFFF" android:strokeLineCap="round" android:strokeLineJoin="round" android:strokeWidth="2.6" />
    </group>
    <group android:translateX="124" android:translateY="55" android:scaleX="0.7" android:scaleY="0.7">
        <path android:pathData="M7,7.4L7,16.6" android:strokeColor="#FFFFFFFF" android:strokeLineCap="round" android:strokeWidth="2.4" />
        <path android:fillColor="#FFFFFFFF" android:pathData="M16.6,7.7L16.6,16.3L10.7,12Z" android:strokeColor="#FFFFFFFF" android:strokeLineCap="round" android:strokeLineJoin="round" android:strokeWidth="2.4" />
    </group>
    <group android:translateX="214" android:translateY="55" android:scaleX="0.7" android:scaleY="0.7">
        <path android:fillColor="#FFFFFFFF" android:pathData="M7.4,7.7L7.4,16.3L13.3,12Z" android:strokeColor="#FFFFFFFF" android:strokeLineCap="round" android:strokeLineJoin="round" android:strokeWidth="2.4" />
        <path android:pathData="M17,7.4L17,16.6" android:strokeColor="#FFFFFFFF" android:strokeLineCap="round" android:strokeWidth="2.4" />
    </group>

    <!-- Progress: track, then the part played. -->
    <path android:pathData="M112,91 L234,91" android:strokeColor="#38FFFFFF" android:strokeLineCap="round" android:strokeWidth="4" />
    <path android:pathData="M112,91 L170,91" android:strokeColor="#E6FFFFFF" android:strokeLineCap="round" android:strokeWidth="4" />

    <!-- Signature diagonal specular rim. -->
    <path android:fillColor="#00FFFFFF" android:pathData="M26,0 L224,0 A26,26 0 0 1 250,26 L250,84 A26,26 0 0 1 224,110 L26,110 A26,26 0 0 1 0,84 L0,26 A26,26 0 0 1 26,0 Z" android:strokeWidth="1.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="250"
                android:endY="110"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item android:color="#CCFFFFFF" android:offset="0" />
                <item android:color="#26FFFFFF" android:offset="0.5" />
                <item android:color="#A6FFFFFF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
