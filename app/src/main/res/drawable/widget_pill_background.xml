<?xml version="1.0" encoding="utf-8"?>
<!--
  The 4×1 capsule before its bitmap arrives: the same clear crystal recipe as
  the square widgets, cut to the capsule's 32dp corner. The real body is baked
  by MediaWidgetArt.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_pill_radius" />
            <solid android:color="#1FFFFFFF" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_pill_radius" />
            <solid android:color="#1A000000" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_pill_radius" />
            <gradient
                android:angle="270"
                android:centerColor="#00FFFFFF"
                android:centerY="0.35"
                android:endColor="#00FFFFFF"
                android:startColor="#47FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_pill_radius" />
            <gradient
                android:angle="270"
                android:centerColor="#00FFFFFF"
                android:centerY="0.85"
                android:endColor="#24FFFFFF"
                android:startColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_pill_radius" />
            <stroke
                android:width="@dimen/widget_glass_rim"
                android:color="#8CFFFFFF" />
        </shape>
    </item>
</layer-list>
