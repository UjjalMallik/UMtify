<?xml version="1.0" encoding="utf-8"?>
<!--
  The 4×1 capsule before its bitmap arrives: the same frosted slate and top
  highlight as the other widgets, cut to the capsule's 32dp corner. The real
  body is baked by MediaWidgetArt, frosted from the album's own colours.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_pill_radius" />
            <gradient
                android:angle="270"
                android:centerColor="#FF1B2130"
                android:centerY="0.45"
                android:endColor="#FF07090E"
                android:startColor="#FF2E3446"
                android:type="linear" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_pill_radius" />
            <gradient
                android:angle="270"
                android:centerColor="#00FFFFFF"
                android:centerY="0.4"
                android:endColor="#00FFFFFF"
                android:startColor="#38FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
