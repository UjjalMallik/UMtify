<?xml version="1.0" encoding="utf-8"?>
<!--
  Picker artwork for the 2×2 widget on hosts older than API 31 — from 31 the
  picker inflates previewLayout instead and this is never seen.

  The liquid-glass card in miniature: the artwork full-bleed under a clear
  crystal pane, the floating dock across the foot of it, and the diagonal
  specular rim that ties them together.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="110dp"
    android:height="110dp"
    android:viewportWidth="110"
    android:viewportHeight="110">

    <!-- The artwork, full-bleed. -->
    <path android:pathData="M26,0 L84,0 A26,26 0 0 1 110,26 L110,84 A26,26 0 0 1 84,110 L26,110 A26,26 0 0 1 0,84 L0,26 A26,26 0 0 1 26,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="0"
                android:endY="110"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item android:color="#FF39405A" android:offset="0" />
                <item android:color="#FF222A3C" android:offset="0.5" />
                <item android:color="#FF0C1018" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Clear pane: white 12% under a 10% scrim. -->
    <path android:fillColor="#1FFFFFFF" android:pathData="M26,0 L84,0 A26,26 0 0 1 110,26 L110,84 A26,26 0 0 1 84,110 L26,110 A26,26 0 0 1 0,84 L0,26 A26,26 0 0 1 26,0 Z" />
    <path android:fillColor="#1A000000" android:pathData="M26,0 L84,0 A26,26 0 0 1 110,26 L110,84 A26,26 0 0 1 84,110 L26,110 A26,26 0 0 1 0,84 L0,26 A26,26 0 0 1 26,0 Z" />

    <!-- Wet sheen over the top 35%. -->
    <path android:pathData="M26,0 L84,0 A26,26 0 0 1 110,26 L110,84 A26,26 0 0 1 84,110 L26,110 A26,26 0 0 1 0,84 L0,26 A26,26 0 0 1 26,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="0"
                android:endY="38"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item android:color="#47FFFFFF" android:offset="0" />
                <item android:color="#00FFFFFF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Bounce along the last 15%. -->
    <path android:pathData="M26,0 L84,0 A26,26 0 0 1 110,26 L110,84 A26,26 0 0 1 84,110 L26,110 A26,26 0 0 1 0,84 L0,26 A26,26 0 0 1 26,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endX="0"
                android:endY="110"
                android:startX="0"
                android:startY="94"
                android:type="linear">
                <item android:color="#00FFFFFF" android:offset="0" />
                <item android:color="#24FFFFFF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Floating crystal dock, 8dp in and 56dp tall. -->
    <path android:fillColor="#2EFFFFFF" android:pathData="M28,46 L82,46 A20,20 0 0 1 102,66 L102,82 A20,20 0 0 1 82,102 L28,102 A20,20 0 0 1 8,82 L8,66 A20,20 0 0 1 28,46 Z" />
    <path android:fillColor="#00FFFFFF" android:pathData="M28,46 L82,46 A20,20 0 0 1 102,66 L102,82 A20,20 0 0 1 82,102 L28,102 A20,20 0 0 1 8,82 L8,66 A20,20 0 0 1 28,46 Z" android:strokeColor="#99FFFFFF" android:strokeWidth="1" />

    <!-- Title. -->
    <path android:pathData="M30,58 L80,58" android:strokeColor="#FFFFFFFF" android:strokeLineCap="round" android:strokeWidth="5" />

    <!-- Previous, play and next, centred in the dock. -->
    <group android:scaleX="0.55" android:scaleY="0.55" android:translateX="17" android:translateY="77">
        <path android:pathData="M7,7.4L7,16.6" android:strokeColor="#FFFFFFFF" android:strokeLineCap="round" android:strokeWidth="2.4" />
        <path android:fillColor="#FFFFFFFF" android:pathData="M16.6,7.7L16.6,16.3L10.7,12Z" android:strokeColor="#FFFFFFFF" android:strokeLineCap="round" android:strokeLineJoin="round" android:strokeWidth="2.4" />
    </group>

    <path android:fillColor="#2EFFFFFF" android:pathData="M45,70 L65,70 A13,13 0 0 1 74,83 A13,13 0 0 1 65,96 L45,96 A13,13 0 0 1 36,83 A13,13 0 0 1 45,70 Z" android:strokeColor="#99FFFFFF" android:strokeWidth="1" />
    <group android:scaleX="0.5" android:scaleY="0.5" android:translateX="49" android:translateY="77">
        <path android:fillColor="#FFFFFFFF" android:pathData="M8.4,6.4L8.4,17.6L17.6,12Z" android:strokeColor="#FFFFFFFF" android:strokeLineCap="round" android:strokeLineJoin="round" android:strokeWidth="2.6" />
    </group>

    <group android:scaleX="0.55" android:scaleY="0.55" android:translateX="79" android:translateY="77">
        <path android:fillColor="#FFFFFFFF" android:pathData="M7.4,7.7L7.4,16.3L13.3,12Z" android:strokeColor="#FFFFFFFF" android:strokeLineCap="round" android:strokeLineJoin="round" android:strokeWidth="2.4" />
        <path android:pathData="M17,7.4L17,16.6" android:strokeColor="#FFFFFFFF" android:strokeLineCap="round" android:strokeWidth="2.4" />
    </group>

    <!-- Signature diagonal specular rim. -->
    <path android:fillColor="#00FFFFFF" android:pathData="M26,0 L84,0 A26,26 0 0 1 110,26 L110,84 A26,26 0 0 1 84,110 L26,110 A26,26 0 0 1 0,84 L0,26 A26,26 0 0 1 26,0 Z" android:strokeWidth="1.5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endX="110"
                android:endY="110"
                android:startX="0"
                android:startY="0"
                android:type="linear">
                <item android:color="#D9FFFFFF" android:offset="0" />
                <item android:color="#40FFFFFF" android:offset="0.5" />
                <item android:color="#B3FFFFFF" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
