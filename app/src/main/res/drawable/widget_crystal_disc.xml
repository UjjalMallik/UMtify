<?xml version="1.0" encoding="utf-8"?>
<!--
  The crystal disc: 34dp, an 18% white fill under a 1.5dp specular rim whose
  colour sweeps diagonally from white 85% at the top-left to 30% at the
  bottom-right.

  The rim is a filled ring rather than a stroked circle. A gradient on a shape's
  <stroke> is not expressible, and a gradient *stroke* in a vector leans on
  platform support that is easy to get wrong; a ring filled with the gradient is
  supported everywhere this app runs, and it lands on the exact 1.5dp band that
  a centred stroke would.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="34dp"
    android:height="34dp"
    android:viewportWidth="34"
    android:viewportHeight="34">

    <!-- The glass body, inset by the rim's own width. -->
    <path
        android:fillColor="#2EFFFFFF"
        android:pathData="M2.25,17a14.75,14.75 0 1,0 29.5,0a14.75,14.75 0 1,0 -29.5,0z" />

    <!-- The rim: outer 16.25 circle with the body's edge punched out of it. -->
    <path
        android:fillType="evenOdd"
        android:pathData="M0.75,17a16.25,16.25 0 1,0 32.5,0a16.25,16.25 0 1,0 -32.5,0zM2.25,17a14.75,14.75 0 1,0 29.5,0a14.75,14.75 0 1,0 -29.5,0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endColor="#4DFFFFFF"
                android:endX="34"
                android:endY="34"
                android:startColor="#D9FFFFFF"
                android:startX="0"
                android:startY="0"
                android:type="linear" />
        </aapt:attr>
    </path>
</vector>
