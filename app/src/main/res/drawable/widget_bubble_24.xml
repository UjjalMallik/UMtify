<?xml version="1.0" encoding="utf-8"?>
<!--
  A 24dp 3D crystal bubble: the 1.2dp specular rim (white 85% down to 20%
  across the middle and back up to 65% at the foot), the convex dome inside it,
  the wet-gloss crescent across the top and the bounce light along the bottom.
  Sized to the view that uses it so the rim never scales below 1.2dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <group>
        <clip-path android:pathData="M0,12a12,12 0 1,0 24,0a12,12 0 1,0 -24,0z" />

        <path android:pathData="M0,12a12,12 0 1,0 24,0a12,12 0 1,0 -24,0z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="12"
                    android:centerY="6.72"
                    android:gradientRadius="18.72"
                    android:startColor="#38FFFFFF"
                    android:endColor="#0DFFFFFF" />
            </aapt:attr>
        </path>

        <path android:pathData="M3.36,8.52a8.64,4.92 0 1,0 17.28,0a8.64,4.92 0 1,0 -17.28,0z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="0"
                    android:startY="3.6"
                    android:endX="0"
                    android:endY="13.44"
                    android:startColor="#66FFFFFF"
                    android:endColor="#14FFFFFF" />
            </aapt:attr>
        </path>

        <path android:pathData="M1.92,23.04a10.08,4.08 0 1,0 20.16,0a10.08,4.08 0 1,0 -20.16,0z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="0"
                    android:startY="17.28"
                    android:endX="0"
                    android:endY="24"
                    android:startColor="#00FFFFFF"
                    android:endColor="#40FFFFFF" />
            </aapt:attr>
        </path>
    </group>

    <path
        android:fillType="evenOdd"
        android:pathData="M0,12a12,12 0 1,0 24,0a12,12 0 1,0 -24,0zM1.2,12a10.8,10.8 0 1,0 21.6,0a10.8,10.8 0 1,0 -21.6,0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="24"
                android:startColor="#D9FFFFFF"
                android:centerColor="#33FFFFFF"
                android:endColor="#A6FFFFFF" />
        </aapt:attr>
    </path>
</vector>
