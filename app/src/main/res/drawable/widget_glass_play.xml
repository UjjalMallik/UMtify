<?xml version="1.0" encoding="utf-8"?>
<!--
  The crystal pill the play/pause sits in, in all three widgets: white 18% over
  the glass, a 60% white border and a touch of sheen across the top. The 20dp
  radius clamps to half the height at every size the layouts give it, so it is
  a pill whether it is 26dp tall in the 2×2 or 28dp in the 4×1.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <solid android:color="#2EFFFFFF" />
                    <stroke
                        android:width="1dp"
                        android:color="#99FFFFFF" />
                </shape>
            </item>

            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="20dp" />
                    <gradient
                        android:angle="270"
                        android:centerColor="#00FFFFFF"
                        android:centerY="0.55"
                        android:endColor="#00FFFFFF"
                        android:startColor="#30FFFFFF"
                        android:type="linear" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
