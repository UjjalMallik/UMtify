<?xml version="1.0" encoding="utf-8"?>
<!--
  The glowing glass pill the play/pause sits in, in all three widgets. The 20dp
  radius clamps to half the height at every size the layouts give it, so it is
  a pill whether it is 28dp tall in the 4×2 or 34dp in the 4×1.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <solid android:color="#33FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#66FFFFFF" />
        </shape>
    </item>
</ripple>
