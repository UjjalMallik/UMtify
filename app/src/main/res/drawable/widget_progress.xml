<?xml version="1.0" encoding="utf-8"?>
<!--
  The 4×2 progress bar, 4dp tall: white 22% track, white 90% fill, both fully
  rounded. RemoteViews cannot tint a ProgressBar at runtime, so the album's
  accent stays in the glass around it rather than on this.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <solid android:color="#38FFFFFF" />
        </shape>
    </item>

    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="2dp" />
                <solid android:color="#E6FFFFFF" />
            </shape>
        </clip>
    </item>
</layer-list>
