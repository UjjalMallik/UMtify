<?xml version="1.0" encoding="utf-8"?>
<!--
  The 2×2 widget's floating dock before its bitmap arrives: frosted dark glass
  with a wet highlight across the top. The real dock frosts whatever artwork is
  beneath it — see MediaWidgetArt — which a drawable cannot do.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_dock_radius" />
            <solid android:color="#4D14181F" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/widget_dock_radius" />
            <gradient
                android:angle="270"
                android:centerColor="#00FFFFFF"
                android:centerY="0.5"
                android:endColor="#00FFFFFF"
                android:startColor="#26FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
