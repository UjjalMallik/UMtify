<?xml version="1.0" encoding="utf-8"?>
<!--
  A 20dp 3D crystal bubble: the 1.2dp specular rim (white 85% down to 20%
  across the middle and back up to 65% at the foot), the convex dome inside it,
  the wet-gloss crescent across the top and the bounce light along the bottom.
  Sized to the view that uses it so the rim never scales below 1.2dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="20dp"
    android:height="20dp"
    android:viewportWidth="20"
    android:viewportHeight="20">

    <group>
        <clip-path android:pathData="M0,10a10,10 0 1,0 20,0a10,10 0 1,0 -20,0z" />

        <path android:pathData="M0,10a10,10 0 1,0 20,0a10,10 0 1,0 -20,0z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="10"
                    android:centerY="5.6"
                    android:gradientRadius="15.6"
                    android:startColor="#38FFFFFF"
                    android:endColor="#0DFFFFFF" />
            </aapt:attr>
        </path>

        <path android:pathData="M2.8,7.1a7.2,4.1 0 1,0 14.4,0a7.2,4.1 0 1,0 -14.4,0z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="0"
                    android:startY="3"
                    android:endX="0"
                    android:endY="11.2"
                    android:startColor="#66FFFFFF"
                    android:endColor="#14FFFFFF" />
            </aapt:attr>
        </path>

        <path android:pathData="M1.6,19.2a8.4,3.4 0 1,0 16.8,0a8.4,3.4 0 1,0 -16.8,0z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="0"
                    android:startY="14.4"
                    android:endX="0"
                    android:endY="20"
                    android:startColor="#00FFFFFF"
                    android:endColor="#40FFFFFF" />
            </aapt:attr>
        </path>
    </group>

    <path
        android:fillType="evenOdd"
        android:pathData="M0,10a10,10 0 1,0 20,0a10,10 0 1,0 -20,0zM1.2,10a8.8,8.8 0 1,0 17.6,0a8.8,8.8 0 1,0 -17.6,0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="20"
                android:startColor="#D9FFFFFF"
                android:centerColor="#33FFFFFF"
                android:endColor="#A6FFFFFF" />
        </aapt:attr>
    </path>
</vector>
