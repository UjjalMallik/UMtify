<?xml version="1.0" encoding="utf-8"?>
<!--
  The 4×2's circular crystal previous/next keys: a faint white disc with a 1dp
  glass edge, under a round ripple. 38dp, so the 9dp padding around each glyph
  keeps the touch target comfortable without a visible ring competing with the
  play pill.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <shape android:shape="oval">
            <solid android:color="#14FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#3DFFFFFF" />
        </shape>
    </item>
</ripple>
