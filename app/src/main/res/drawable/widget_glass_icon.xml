<?xml version="1.0" encoding="utf-8"?>
<!--
  A tactile glass icon button: a barely-there white disc with a 1dp glass edge,
  under the same oval ripple the old transport buttons used. The edge is what
  makes a row of them read as physical keys rather than floating glyphs.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">
    <item>
        <shape android:shape="oval">
            <solid android:color="#14FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#3DFFFFFF" />
        </shape>
    </item>
</ripple>
