<?xml version="1.0" encoding="utf-8"?>
<!--
  A 34dp 3D crystal bubble: the 1.2dp specular rim (white 85% down to 20%
  across the middle and back up to 65% at the foot), the convex dome inside it,
  the wet-gloss crescent across the top and the bounce light along the bottom.
  Sized to the view that uses it so the rim never scales below 1.2dp.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="34dp"
    android:height="34dp"
    android:viewportWidth="34"
    android:viewportHeight="34">

    <group>
        <clip-path android:pathData="M0,17a17,17 0 1,0 34,0a17,17 0 1,0 -34,0z" />

        <path android:pathData="M0,17a17,17 0 1,0 34,0a17,17 0 1,0 -34,0z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="17"
                    android:centerY="9.52"
                    android:gradientRadius="26.52"
                    android:startColor="#38FFFFFF"
                    android:endColor="#0DFFFFFF" />
            </aapt:attr>
        </path>

        <path android:pathData="M4.76,12.07a12.24,6.97 0 1,0 24.48,0a12.24,6.97 0 1,0 -24.48,0z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="0"
                    android:startY="5.1"
                    android:endX="0"
                    android:endY="19.04"
                    android:startColor="#66FFFFFF"
                    android:endColor="#14FFFFFF" />
            </aapt:attr>
        </path>

        <path android:pathData="M2.72,32.64a14.28,5.78 0 1,0 28.56,0a14.28,5.78 0 1,0 -28.56,0z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="0"
                    android:startY="24.48"
                    android:endX="0"
                    android:endY="34"
                    android:startColor="#00FFFFFF"
                    android:endColor="#40FFFFFF" />
            </aapt:attr>
        </path>
    </group>

    <path
        android:fillType="evenOdd"
        android:pathData="M0,17a17,17 0 1,0 34,0a17,17 0 1,0 -34,0zM1.2,17a15.8,15.8 0 1,0 31.6,0a15.8,15.8 0 1,0 -31.6,0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="34"
                android:startColor="#D9FFFFFF"
                android:centerColor="#33FFFFFF"
                android:endColor="#A6FFFFFF" />
        </aapt:attr>
    </path>
</vector>
