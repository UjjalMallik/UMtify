<?xml version="1.0" encoding="utf-8"?>
<!--
  The 24dp crystal disc the 2×2 dock's previous/next sit in. Small enough that
  both discs and the play pill still fit the dock at the widget's 110dp minimum.
  See widget_crystal_disc for the rim.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <path
        android:fillColor="#2EFFFFFF"
        android:pathData="M2.25,12a9.75,9.75 0 1,0 19.5,0a9.75,9.75 0 1,0 -19.5,0z" />

    <path
        android:fillType="evenOdd"
        android:pathData="M0.75,12a11.25,11.25 0 1,0 22.5,0a11.25,11.25 0 1,0 -22.5,0zM2.25,12a9.75,9.75 0 1,0 19.5,0a9.75,9.75 0 1,0 -19.5,0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endColor="#4DFFFFFF"
                android:endX="24"
                android:endY="24"
                android:startColor="#D9FFFFFF"
                android:startX="0"
                android:startY="0"
                android:type="linear" />
        </aapt:attr>
    </path>
</vector>
