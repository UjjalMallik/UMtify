<?xml version="1.0" encoding="utf-8"?>
<!--
  The 4×2 widget: the reference's large glass card in two tiers.

  The upper tier is the 104dp artwork tile beside the deck — title, artist, the
  crystal seek bar with its timestamps and the five bubble keys. The lower tier
  is the full-width crystal ribbon: a 28dp wave that spans the card edge to edge,
  under the tile as well as the deck, and takes the whole dead strip along the
  foot. When the card is too short to hold both tiers MediaWidget hides the
  ribbon and the upper tier keeps the height.

  The ribbon is a sibling of the content, not a row of it, so it is not inset by
  the padding either. Its bitmap is drawn with the card's own bottom corners
  rounded, because a FrameLayout does not clip its children to its background.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_background">

    <ImageView
        android:id="@+id/widget_glass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/widget_wide_padding"
            android:paddingTop="@dimen/widget_wide_padding"
            android:paddingEnd="@dimen/widget_wide_padding">

            <ImageView
                android:id="@+id/widget_art"
                android:layout_width="@dimen/widget_wide_art"
                android:layout_height="@dimen/widget_wide_art"
                android:contentDescription="@string/widget_artwork"
                android:scaleType="fitXY"
                android:src="@drawable/widget_art_placeholder_wide" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/widget_wide_gap"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/sf_pro_display_semibold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#99000000"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:textColor="#FFFFFFFF"
                    android:textSize="16sp" android:text="@string/widget_preview_title" />

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/sf_pro_display_regular"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#99000000"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:textColor="#BFFFFFFF"
                    android:textSize="13sp" android:text="@string/widget_preview_artist" />

                <LinearLayout
                    android:id="@+id/widget_progress_row"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/widget_wide_progress_row"
                    android:layout_marginTop="4dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Chronometer
                        android:id="@+id/widget_elapsed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_pro_display_regular"
                        android:includeFontPadding="false"
                        android:shadowColor="#99000000"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:textColor="#99FFFFFF"
                        android:textSize="11sp" />

                    <ImageView
                        android:id="@+id/widget_seek"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/widget_wide_seek_height"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:importantForAccessibility="no"
                        android:scaleType="fitXY" />

                    <TextView
                        android:id="@+id/widget_total"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_pro_display_regular"
                        android:includeFontPadding="false"
                        android:shadowColor="#99000000"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:textColor="#99FFFFFF"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Shuffle, the transport, Like — one tight, centred row. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/widget_wide_transport"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_shuffle"
                        android:layout_width="@dimen/widget_wide_key"
                        android:layout_height="@dimen/widget_wide_key"
                        android:background="@drawable/widget_bubble_22"
                        android:contentDescription="@string/shuffle_off"
                        android:padding="5.5dp"
                        android:src="@drawable/ic_widget_shuffle" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/widget_previous"
                        android:layout_width="@dimen/widget_wide_prev"
                        android:layout_height="@dimen/widget_wide_prev"
                        android:background="@drawable/widget_bubble_36"
                        android:contentDescription="@string/widget_previous"
                        android:padding="9.5dp"
                        android:src="@drawable/ic_widget_previous" />

                    <FrameLayout
                        android:layout_width="@dimen/widget_wide_button_gap"
                        android:layout_height="1dp" />

                    <ImageView
                        android:id="@+id/widget_toggle"
                        android:layout_width="@dimen/widget_wide_play"
                        android:layout_height="@dimen/widget_wide_play"
                        android:background="@drawable/widget_bubble_44"
                        android:contentDescription="@string/widget_play"
                        android:padding="12dp"
                        android:src="@drawable/ic_widget_play" />

                    <FrameLayout
                        android:layout_width="@dimen/widget_wide_button_gap"
                        android:layout_height="1dp" />

                    <ImageView
                        android:id="@+id/widget_next"
                        android:layout_width="@dimen/widget_wide_prev"
                        android:layout_height="@dimen/widget_wide_prev"
                        android:background="@drawable/widget_bubble_36"
                        android:contentDescription="@string/widget_next"
                        android:padding="9.5dp"
                        android:src="@drawable/ic_widget_next" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/widget_like"
                        android:layout_width="@dimen/widget_wide_key"
                        android:layout_height="@dimen/widget_wide_key"
                        android:background="@drawable/widget_bubble_22"
                        android:contentDescription="@string/like"
                        android:padding="5.5dp"
                        android:src="@drawable/ic_widget_heart" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- The full-width ribbon, flush with the foot of the card. -->
        <ImageView
            android:id="@+id/widget_wave"
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_wide_wave_height"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />
    </LinearLayout>
</FrameLayout>
