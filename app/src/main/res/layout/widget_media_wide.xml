<?xml version="1.0" encoding="utf-8"?>
<!--
  The 4×2 widget: a square artwork tile on the left, the deck beside it — the
  layout of the reference crystal-glass card, and of either widget when it is at
  MediaWidget.WIDE_LAYOUT_MIN_DP or wider.

  The tile is an ImageView of the card's own size, inset at runtime to where the
  square belongs — see MediaWidget.views. It uses `scaleType="matrix"`, so its
  bitmap is drawn 1:1 at the size it was composited, never stretched to the
  host's idea of the card, and the deck is padded past it. Both insets are
  absolute px, so they move together and can never overlap.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_background">

    <!-- fitXY, not centerCrop: the bitmap is composited at the widget's exact
         pixel size, so this is a 1:1 blit. -->
    <ImageView
        android:id="@+id/widget_glass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <!-- The artwork tile. Drawn at its own size, positioned by the runtime
         padding, so it is never stretched and never under the deck. It has no
         placeholder src: one drawn at the picker's ideal 112dp would overlap the
         deck on a narrower card while the cover loads. -->
    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="matrix" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/widget_wide_padding"
        android:paddingEnd="@dimen/widget_wide_padding">

        <!-- Starts where the tile ends; the left padding is set at runtime. -->
        <LinearLayout
            android:id="@+id/widget_deck"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <!-- Title and artist, with the crystal Like disc on the right. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="6dp">

                    <TextView
                        android:id="@+id/widget_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:shadowColor="#99000000"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/widget_artist"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/sf_pro_display_regular"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:shadowColor="#99000000"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:textColor="#CCFFFFFF"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/widget_like"
                    android:layout_width="@dimen/widget_like_size"
                    android:layout_height="@dimen/widget_like_size"
                    android:background="@drawable/widget_glass_like"
                    android:contentDescription="@string/like"
                    android:padding="8dp"
                    android:src="@drawable/ic_widget_heart" />
            </LinearLayout>

            <!-- Previous, play in its own crystal pill, next — evenly spread. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/widget_wide_transport"
                android:layout_marginTop="@dimen/widget_wide_transport_gap"
                android:layout_marginBottom="@dimen/widget_wide_transport_gap"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_previous"
                    android:layout_width="@dimen/widget_wide_transport"
                    android:layout_height="@dimen/widget_wide_transport"
                    android:background="@drawable/widget_glass_icon"
                    android:contentDescription="@string/widget_previous"
                    android:padding="9dp"
                    android:src="@drawable/ic_widget_previous" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/widget_toggle"
                    android:layout_width="@dimen/widget_wide_play_width"
                    android:layout_height="@dimen/widget_wide_play_height"
                    android:background="@drawable/widget_glass_play"
                    android:contentDescription="@string/widget_play"
                    android:padding="8dp"
                    android:src="@drawable/ic_widget_play" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/widget_next"
                    android:layout_width="@dimen/widget_wide_transport"
                    android:layout_height="@dimen/widget_wide_transport"
                    android:background="@drawable/widget_glass_icon"
                    android:contentDescription="@string/widget_next"
                    android:padding="9dp"
                    android:src="@drawable/ic_widget_next" />
            </LinearLayout>

            <!-- Elapsed, the crystal progress bar, and the track's length. -->
            <LinearLayout
                android:id="@+id/widget_progress_row"
                android:layout_width="match_parent"
                android:layout_height="@dimen/widget_wide_progress_row"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Chronometer
                    android:id="@+id/widget_elapsed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sf_pro_display_regular"
                    android:includeFontPadding="false"
                    android:shadowColor="#99000000"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp" />

                <ProgressBar
                    android:id="@+id/widget_progress"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progressDrawable="@drawable/widget_progress" />

                <TextView
                    android:id="@+id/widget_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sf_pro_display_regular"
                    android:includeFontPadding="false"
                    android:shadowColor="#99000000"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
