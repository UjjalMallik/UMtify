<?xml version="1.0" encoding="utf-8"?>
<!--
  What the picker shows for the 4×1 widget on API 31+: widget_media_pill with
  stand-in text, a stand-in artwork tile, a still spectrum frame and the
  capsule's fallback frost. See that file for the layout.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_pill_height"
        android:layout_gravity="center_vertical"
        android:background="@drawable/widget_pill_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/widget_pill_padding_h"
            android:paddingTop="@dimen/widget_pill_padding_v"
            android:paddingEnd="@dimen/widget_pill_padding_h"
            android:paddingBottom="@dimen/widget_pill_padding_v">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="@dimen/widget_pill_art"
                android:layout_marginEnd="@dimen/widget_pill_gap"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_art_placeholder_pill" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/sf_pro_display_semibold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#99000000"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:text="@string/widget_preview_pill"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/widget_wave_pill_height"
                    android:layout_marginTop="1dp"
                    android:layout_marginBottom="1dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/widget_wave_preview" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/widget_pill_play_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/widget_pill_button"
                        android:layout_height="@dimen/widget_pill_button"
                        android:background="@drawable/widget_crystal_disc_small"
                        android:contentDescription="@string/like"
                        android:padding="5dp"
                        android:src="@drawable/ic_widget_heart" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:layout_width="@dimen/widget_pill_button"
                        android:layout_height="@dimen/widget_pill_button"
                        android:background="@drawable/widget_crystal_disc_small"
                        android:contentDescription="@string/widget_previous"
                        android:padding="5dp"
                        android:src="@drawable/ic_widget_previous" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:layout_width="@dimen/widget_pill_play_width"
                        android:layout_height="@dimen/widget_pill_play_height"
                        android:background="@drawable/widget_crystal_pill_pill"
                        android:contentDescription="@string/widget_play"
                        android:padding="4dp"
                        android:src="@drawable/ic_widget_play" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:layout_width="@dimen/widget_pill_button"
                        android:layout_height="@dimen/widget_pill_button"
                        android:background="@drawable/widget_crystal_disc_small"
                        android:contentDescription="@string/widget_next"
                        android:padding="5dp"
                        android:src="@drawable/ic_widget_next" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:layout_width="@dimen/widget_pill_button"
                        android:layout_height="@dimen/widget_pill_button"
                        android:background="@drawable/widget_crystal_disc_small"
                        android:contentDescription="@string/shuffle_off"
                        android:padding="5dp"
                        android:src="@drawable/ic_widget_shuffle" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
