<?xml version="1.0" encoding="utf-8"?>
<!--
  The 4×1 widget: a clear crystal capsule with the artwork tile inset at its
  left, the track and its spectrum above the transport beside it.

  The controls are fixed-size crystal keys with weight-1 spacers between them,
  not weight-1 keys: an oval stretched to share the row evenly was exactly what
  made the old row read as five squashed pills. At fewer than
  MediaWidgetPill.COMPACT_WIDTH_DP the provider hides the tile, Like and Shuffle
  outright, leaving previous / play / next spread across the capsule's full
  width with the title centred over them.

  The capsule is wrap_content tall and centred rather than filling the cell. A
  one-row cell is anywhere from ~60dp to over 100dp tall depending on the
  launcher, and a capsule stretched to the taller end stops reading as one.

  The root is transparent and not clickable, so a tap beside the capsule falls
  through to the home screen; widget_pill is what opens the app.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/widget_pill"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_pill_height"
        android:layout_gravity="center_vertical"
        android:background="@drawable/widget_pill_background">

        <ImageView
            android:id="@+id/widget_glass"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/widget_pill_padding_h"
            android:paddingTop="@dimen/widget_pill_padding_v"
            android:paddingEnd="@dimen/widget_pill_padding_h"
            android:paddingBottom="@dimen/widget_pill_padding_v">

            <ImageView
                android:id="@+id/widget_art"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/widget_pill_art"
                android:layout_marginEnd="@dimen/widget_pill_gap"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_art_placeholder_pill" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/sf_pro_display_semibold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#99000000"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp" />

                <!-- The spectrum under the title; see widget_media_wide. -->
                <ImageView
                    android:id="@+id/widget_wave"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/widget_wave_pill_height"
                    android:layout_marginTop="1dp"
                    android:layout_marginBottom="1dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/widget_pill_play_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/widget_like"
                        android:layout_width="@dimen/widget_pill_button"
                        android:layout_height="@dimen/widget_pill_button"
                        android:background="@drawable/widget_crystal_disc_small"
                        android:contentDescription="@string/like"
                        android:padding="5dp"
                        android:src="@drawable/ic_widget_heart" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/widget_previous"
                        android:layout_width="@dimen/widget_pill_button"
                        android:layout_height="@dimen/widget_pill_button"
                        android:background="@drawable/widget_crystal_disc_small"
                        android:contentDescription="@string/widget_previous"
                        android:padding="5dp"
                        android:src="@drawable/ic_widget_previous" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/widget_toggle"
                        android:layout_width="@dimen/widget_pill_play_width"
                        android:layout_height="@dimen/widget_pill_play_height"
                        android:background="@drawable/widget_crystal_pill_pill"
                        android:contentDescription="@string/widget_play"
                        android:padding="4dp"
                        android:src="@drawable/ic_widget_play" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/widget_next"
                        android:layout_width="@dimen/widget_pill_button"
                        android:layout_height="@dimen/widget_pill_button"
                        android:background="@drawable/widget_crystal_disc_small"
                        android:contentDescription="@string/widget_next"
                        android:padding="5dp"
                        android:src="@drawable/ic_widget_next" />

                    <FrameLayout
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:id="@+id/widget_shuffle"
                        android:layout_width="@dimen/widget_pill_button"
                        android:layout_height="@dimen/widget_pill_button"
                        android:background="@drawable/widget_crystal_disc_small"
                        android:contentDescription="@string/shuffle_off"
                        android:padding="5dp"
                        android:src="@drawable/ic_widget_shuffle" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
