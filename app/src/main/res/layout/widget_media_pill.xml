<?xml version="1.0" encoding="utf-8"?>
<!--
  The 4×1 widget: the reference's horizontal crystal capsule.

  The capsule fills the cell, inset 4dp top and bottom, rather than sitting at a
  fixed height in the middle of it — a one-row cell is not the same height on
  two launchers, and a capsule shorter than its cell was leaving transparent
  bands above and below that read as wasted grid space.

  Inside: the 54dp tile, the track column beside it (title, artist and the
  twelve-bar wave under them), and the three bubble keys on the right. Nothing
  else — no timestamps, no seek bar, no corner keys — so previous, play/pause
  and next are the full size of the bar instead of sharing it.

  The root is transparent and not clickable, so a tap beside the capsule falls
  through to the home screen; widget_pill is what opens the app.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/widget_pill"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/widget_pill_margin"
        android:layout_marginBottom="@dimen/widget_pill_margin"
        android:background="@drawable/widget_pill_background">

        <ImageView
            android:id="@+id/widget_glass"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/widget_pill_padding_h"
            android:paddingEnd="@dimen/widget_pill_padding_h">

            <ImageView
                android:id="@+id/widget_art"
                android:layout_width="@dimen/widget_pill_art"
                android:layout_height="@dimen/widget_pill_art"
                android:layout_marginEnd="@dimen/widget_pill_gap"
                android:contentDescription="@string/widget_artwork"
                android:scaleType="fitXY"
                android:src="@drawable/widget_art_placeholder_pill" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/sf_pro_display_semibold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#99000000"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:textColor="#FFFFFFFF"
                    android:textSize="15sp" android:text="@string/widget_preview_title" />

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/sf_pro_display_regular"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#99000000"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12.5sp" android:text="@string/widget_preview_artist" />

                <ImageView
                    android:id="@+id/widget_wave"
                    android:layout_width="@dimen/widget_pill_wave_width"
                    android:layout_height="@dimen/widget_pill_wave_height"
                    android:layout_marginTop="@dimen/widget_pill_wave_gap"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="@dimen/widget_pill_transport"
                android:layout_marginStart="@dimen/widget_pill_gap"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_previous"
                    android:layout_width="@dimen/widget_pill_prev"
                    android:layout_height="@dimen/widget_pill_prev"
                    android:background="@drawable/widget_bubble_40"
                    android:contentDescription="@string/widget_previous"
                    android:padding="10.5dp"
                    android:src="@drawable/ic_widget_previous" />

                <FrameLayout
                    android:layout_width="@dimen/widget_pill_button_gap"
                    android:layout_height="1dp" />

                <ImageView
                    android:id="@+id/widget_toggle"
                    android:layout_width="@dimen/widget_pill_play"
                    android:layout_height="@dimen/widget_pill_play"
                    android:background="@drawable/widget_bubble_48"
                    android:contentDescription="@string/widget_play"
                    android:padding="13dp"
                    android:src="@drawable/ic_widget_play" />

                <FrameLayout
                    android:layout_width="@dimen/widget_pill_button_gap"
                    android:layout_height="1dp" />

                <ImageView
                    android:id="@+id/widget_next"
                    android:layout_width="@dimen/widget_pill_prev"
                    android:layout_height="@dimen/widget_pill_prev"
                    android:background="@drawable/widget_bubble_40"
                    android:contentDescription="@string/widget_next"
                    android:padding="10.5dp"
                    android:src="@drawable/ic_widget_next" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
