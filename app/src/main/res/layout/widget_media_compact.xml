<?xml version="1.0" encoding="utf-8"?>
<!--
  The 2×2 widget: the album art full-bleed inside the crystal frame, with a
  floating dock across the foot of it.

  Three layers: the artwork (`widget_art`), the glass (`widget_glass` — the
  clear pane, its wet sheen, the rim and the dock's frost, all drawn by
  MediaWidgetArt) and the dock's contents, which the layout places. The dock has
  no background of its own: the glass underneath it *is* the dock.

  The dock is not clickable itself, so its empty space falls through to the root
  and opens the app, like any other pixel of the artwork.

  The keys are fixed 24dp discs with weight-1 spacers between them rather than
  weight-1 keys: a circle given a weighted width is drawn as an oval, and two
  discs plus the 34dp play pill are the most that fit the dock's smallest card.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_background">

    <ImageView
        android:id="@+id/widget_art"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_art_placeholder_compact" />

    <ImageView
        android:id="@+id/widget_glass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/widget_dock"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_dock_height"
        android:layout_gravity="bottom"
        android:layout_margin="@dimen/widget_dock_margin"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/sf_pro_display_semibold"
            android:gravity="center_horizontal"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="#99000000"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textColor="#FFFFFFFF"
            android:textSize="12.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_compact_button"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_previous"
                android:layout_width="@dimen/widget_compact_disc"
                android:layout_height="@dimen/widget_compact_disc"
                android:background="@drawable/widget_crystal_ring_small"
                android:contentDescription="@string/widget_previous"
                android:padding="4dp"
                android:src="@drawable/ic_widget_previous" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_toggle"
                android:layout_width="@dimen/widget_compact_play_width"
                android:layout_height="@dimen/widget_compact_play_height"
                android:background="@drawable/widget_crystal_pill_compact"
                android:contentDescription="@string/widget_play"
                android:padding="3dp"
                android:src="@drawable/ic_widget_play" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="@dimen/widget_compact_disc"
                android:layout_height="@dimen/widget_compact_disc"
                android:background="@drawable/widget_crystal_ring_small"
                android:contentDescription="@string/widget_next"
                android:padding="4dp"
                android:src="@drawable/ic_widget_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
