<?xml version="1.0" encoding="utf-8"?>
<!--
  The 2×2 widget: the reference's square frosted glass card.

  One centred column, three bands: the 64dp artwork tile with the title and
  artist beside it, the wave and its seek bar across the middle, and the three
  transport bubbles in a single centred row. The column is centred vertically
  rather than pinned top and bottom, so a card that is a little taller than its
  content splits the difference above and below instead of opening a void
  between the seek bar and the buttons.

  All three bands are unconditional. The widget is one fixed 2×2 design — not
  resizable — and the host lays the layout out at the cell's real width, which
  is wider than the 70n − 30 figure the options bundle reports; dropping a band
  on that figure would have hidden the wave on every phone.

  Everything except the artwork is glass the provider bakes or vectors it
  points at; the only bitmaps set at runtime are the tile, the face, the
  seek bar and the equalizer frame.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_background">

    <ImageView
        android:id="@+id/widget_glass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="@dimen/widget_card_padding">

        <!-- Tile, then the track. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_art"
                android:layout_width="@dimen/widget_card_art"
                android:layout_height="@dimen/widget_card_art"
                android:contentDescription="@string/widget_artwork"
                android:scaleType="fitXY"
                android:src="@drawable/widget_art_placeholder_compact" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/widget_card_gap"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/sf_pro_display_semibold"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#99000000"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp" android:text="@string/widget_preview_title" />

                <TextView
                    android:id="@+id/widget_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/sf_pro_display_regular"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:shadowColor="#99000000"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:textColor="#BFFFFFFF"
                    android:textSize="11.5sp" android:text="@string/widget_preview_artist" />
            </LinearLayout>
        </LinearLayout>

        <!-- The equalizer across the full inner width, then the seek bar. -->
        <ImageView
            android:id="@+id/widget_wave"
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_card_wave_height"
            android:layout_marginTop="@dimen/widget_card_wave_gap"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/widget_seek"
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_card_seek_height"
            android:layout_marginTop="@dimen/widget_card_seek_gap"
            android:importantForAccessibility="no"
            android:scaleType="fitXY" />

        <!-- Previous, play/pause and next, centred as one tight group. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_card_transport"
            android:layout_marginTop="@dimen/widget_card_transport_top"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_previous"
                android:layout_width="@dimen/widget_card_prev"
                android:layout_height="@dimen/widget_card_prev"
                android:background="@drawable/widget_bubble_36"
                android:contentDescription="@string/widget_previous"
                android:padding="9.5dp"
                android:src="@drawable/ic_widget_previous" />

            <FrameLayout
                android:layout_width="@dimen/widget_card_transport_gap"
                android:layout_height="1dp" />

            <ImageView
                android:id="@+id/widget_toggle"
                android:layout_width="@dimen/widget_card_play"
                android:layout_height="@dimen/widget_card_play"
                android:background="@drawable/widget_bubble_40"
                android:contentDescription="@string/widget_play"
                android:padding="11dp"
                android:src="@drawable/ic_widget_play" />

            <FrameLayout
                android:layout_width="@dimen/widget_card_transport_gap"
                android:layout_height="1dp" />

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="@dimen/widget_card_prev"
                android:layout_height="@dimen/widget_card_prev"
                android:background="@drawable/widget_bubble_36"
                android:contentDescription="@string/widget_next"
                android:padding="9.5dp"
                android:src="@drawable/ic_widget_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
