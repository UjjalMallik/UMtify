<?xml version="1.0" encoding="utf-8"?>
<!--
  The 2×2 widget: the artwork inside a 26dp glass frame, with a floating frosted
  dock across the foot of it.

  The frame, the 3dp-inset artwork and the dock are one bitmap drawn by
  MediaWidgetArt — RemoteViews cannot blur, so the dock's frost has to be baked
  from the artwork beneath it. The dock here is only the glass that sits on top:
  a transparent container in exactly the place the compositor painted the dock,
  carrying the title and the three controls.

  The dock is not clickable itself, so its empty space falls through to the root
  and opens the app, like any other pixel of the artwork.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_background">

    <ImageView
        android:id="@+id/widget_glass"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/widget_dock"
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_dock_height"
        android:layout_gravity="bottom"
        android:layout_margin="@dimen/widget_dock_margin"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingLeft="4dp"
        android:paddingRight="4dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/sf_pro_display_semibold"
            android:gravity="center_horizontal"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_compact_button"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_previous"
                android:layout_width="0dp"
                android:layout_height="@dimen/widget_compact_button"
                android:layout_weight="1"
                android:contentDescription="@string/widget_previous"
                android:padding="5dp"
                android:src="@drawable/ic_widget_previous" />

            <ImageView
                android:id="@+id/widget_toggle"
                android:layout_width="@dimen/widget_compact_play_width"
                android:layout_height="@dimen/widget_compact_button"
                android:background="@drawable/widget_glass_play"
                android:contentDescription="@string/widget_play"
                android:padding="5dp"
                android:src="@drawable/ic_widget_play" />

            <ImageView
                android:id="@+id/widget_next"
                android:layout_width="0dp"
                android:layout_height="@dimen/widget_compact_button"
                android:layout_weight="1"
                android:contentDescription="@string/widget_next"
                android:padding="5dp"
                android:src="@drawable/ic_widget_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
