<?xml version="1.0" encoding="utf-8"?>
<!--
  What the picker shows for the 2×2 widget on API 31+, where previewLayout is
  inflated live rather than an image being drawn.

  A copy of widget_media_compact with stand-in text, a stand-in artwork tile and
  the dock's own fallback frost. The real dock is baked into the glass bitmap —
  it has no background of its own.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_art_placeholder_compact" />

    <!-- The clear pane over the art: the same fallback the real layout carries
         underneath its bitmap, so the wall showing through reads the same. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_glass_background"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/widget_dock_height"
        android:layout_gravity="bottom"
        android:layout_margin="@dimen/widget_dock_margin"
        android:background="@drawable/widget_dock_background"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingTop="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="4dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/sf_pro_display_semibold"
            android:gravity="center_horizontal"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:shadowColor="#99000000"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:text="@string/widget_preview_title"
            android:textColor="#FFFFFFFF"
            android:textSize="12.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_compact_button"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="@dimen/widget_compact_button"
                android:layout_weight="1"
                android:contentDescription="@string/widget_previous"
                android:padding="5dp"
                android:src="@drawable/ic_widget_previous" />

            <ImageView
                android:layout_width="@dimen/widget_compact_play_width"
                android:layout_height="@dimen/widget_compact_play_height"
                android:background="@drawable/widget_glass_play"
                android:contentDescription="@string/widget_play"
                android:padding="4dp"
                android:src="@drawable/ic_widget_play" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="@dimen/widget_compact_button"
                android:layout_weight="1"
                android:contentDescription="@string/widget_next"
                android:padding="5dp"
                android:src="@drawable/ic_widget_next" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
