<?xml version="1.0" encoding="utf-8"?>
<!--
  What the picker shows for the 4×2 widget on API 31+, where previewLayout is
  inflated live rather than an image being drawn.

  A copy of widget_media_wide with stand-in text, a stand-in artwork tile and a
  part-filled progress bar — and, unlike the real layout, the tile participates
  in the row so the deck starts exactly where it ends without a runtime padding.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/widget_wide_padding"
        android:paddingEnd="@dimen/widget_wide_padding">

        <!-- match_parent tall and square via adjustViewBounds, as in the real
             layout, so the tile shrinks with a short preview instead of
             crowding the deck. -->
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/widget_wide_gap"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="fitXY"
            android:src="@drawable/widget_art_placeholder_wide" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="6dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:shadowColor="#99000000"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:text="@string/widget_preview_title"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/sf_pro_display_regular"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:shadowColor="#99000000"
                        android:shadowDy="1"
                        android:shadowRadius="4"
                        android:text="@string/widget_preview_artist"
                        android:textColor="#CCFFFFFF"
                        android:textSize="12.5sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/widget_like_size"
                    android:layout_height="@dimen/widget_like_size"
                    android:background="@drawable/widget_glass_like"
                    android:contentDescription="@string/like"
                    android:padding="8dp"
                    android:src="@drawable/ic_widget_heart" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/widget_wide_transport"
                android:layout_marginTop="@dimen/widget_wide_transport_gap"
                android:layout_marginBottom="@dimen/widget_wide_transport_gap"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/widget_wide_transport"
                    android:layout_height="@dimen/widget_wide_transport"
                    android:background="@drawable/widget_glass_icon"
                    android:contentDescription="@string/widget_previous"
                    android:padding="9dp"
                    android:src="@drawable/ic_widget_previous" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:layout_width="@dimen/widget_wide_play_width"
                    android:layout_height="@dimen/widget_wide_play_height"
                    android:background="@drawable/widget_glass_play"
                    android:contentDescription="@string/widget_play"
                    android:padding="8dp"
                    android:src="@drawable/ic_widget_play" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:layout_width="@dimen/widget_wide_transport"
                    android:layout_height="@dimen/widget_wide_transport"
                    android:background="@drawable/widget_glass_icon"
                    android:contentDescription="@string/widget_next"
                    android:padding="9dp"
                    android:src="@drawable/ic_widget_next" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/widget_wide_progress_row"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sf_pro_display_regular"
                    android:includeFontPadding="false"
                    android:shadowColor="#99000000"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:text="1:35"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp" />

                <ProgressBar
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="4dp"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progress="430"
                    android:progressDrawable="@drawable/widget_progress" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sf_pro_display_regular"
                    android:includeFontPadding="false"
                    android:shadowColor="#99000000"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:text="3:40"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
