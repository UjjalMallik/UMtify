<?xml version="1.0" encoding="utf-8"?>
<!--
  What the picker shows for the 4×2 widget on API 31+, where previewLayout is
  inflated live rather than an image being drawn.

  A copy of widget_media_wide with stand-in text, a stand-in artwork tile and a
  part-filled progress bar. The real layout leaves the tile transparent because
  the provider bakes the artwork into the glass; here there is no bitmap, so the
  tile carries the placeholder gradient instead.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_glass_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="@dimen/widget_wide_padding"
        android:paddingRight="@dimen/widget_wide_padding">

        <FrameLayout
            android:layout_width="@dimen/widget_wide_art"
            android:layout_height="@dimen/widget_wide_art"
            android:background="@drawable/widget_art_placeholder_wide" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="@dimen/widget_wide_art"
            android:layout_marginLeft="@dimen/widget_wide_gap"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/widget_wide_title_row"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingRight="6dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/sf_pro_display_semibold"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_preview_title"
                        android:textColor="#FFFFFFFF"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/sf_pro_display_regular"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:text="@string/widget_preview_artist"
                        android:textColor="#B8FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/widget_like_size"
                    android:layout_height="@dimen/widget_like_size"
                    android:background="@drawable/widget_glass_like"
                    android:contentDescription="@string/like"
                    android:padding="8dp"
                    android:src="@drawable/ic_widget_heart" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/widget_wide_transport"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/widget_wide_transport"
                    android:layout_height="@dimen/widget_wide_transport"
                    android:contentDescription="@string/widget_previous"
                    android:padding="4dp"
                    android:src="@drawable/ic_widget_previous" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:layout_width="@dimen/widget_play_pill_width"
                    android:layout_height="@dimen/widget_play_pill_height"
                    android:background="@drawable/widget_glass_play"
                    android:contentDescription="@string/widget_play"
                    android:padding="6dp"
                    android:src="@drawable/ic_widget_play" />

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:layout_width="@dimen/widget_wide_transport"
                    android:layout_height="@dimen/widget_wide_transport"
                    android:contentDescription="@string/widget_next"
                    android:padding="4dp"
                    android:src="@drawable/ic_widget_next" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/widget_wide_progress_row"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sf_pro_display_regular"
                    android:includeFontPadding="false"
                    android:text="1:35"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp" />

                <ProgressBar
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="0dp"
                    android:layout_height="5dp"
                    android:layout_marginLeft="6dp"
                    android:layout_marginRight="6dp"
                    android:layout_weight="1"
                    android:max="1000"
                    android:progress="430"
                    android:progressDrawable="@drawable/widget_progress" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sf_pro_display_regular"
                    android:includeFontPadding="false"
                    android:text="3:40"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
