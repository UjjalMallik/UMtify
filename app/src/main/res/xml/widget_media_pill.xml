<?xml version="1.0" encoding="utf-8"?>
<!--
  The 4×1 entry in the widget picker: the crystal capsule with the 58dp cover,
  the track and its twelve-bar wave, the seek bar, and Shuffle / Repeat beside
  previous / play / next. Its own provider and layout, not another size of
  MediaWidget — it has no artwork tile beside a deck, so none of that widget's
  measuring applies.

  One row by the launcher's 70n − 30 arithmetic is 40dp; the capsule is 92dp and
  centred, so minHeight asks for the height the capsule actually needs rather
  than the nominal row. Resizable horizontally only, and not below three cells:
  the title and five keys need that much before the buttons crowd. Below
  MediaWidgetPill.COMPACT_WIDTH_DP the capsule drops the cover and the corner
  keys and centres the title over three transport buttons.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_pill_description"
    android:initialLayout="@layout/widget_media_pill"
    android:minHeight="92dp"
    android:minResizeWidth="180dp"
    android:minWidth="250dp"
    android:previewImage="@drawable/widget_preview_pill"
    android:previewLayout="@layout/widget_media_pill"
    android:resizeMode="horizontal"
    android:targetCellHeight="1"
    android:targetCellWidth="4"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
