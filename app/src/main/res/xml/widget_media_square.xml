<?xml version="1.0" encoding="utf-8"?>
<!--
  The 2×2 entry in the widget picker: one square card, two cells by two.

  Sizes follow the launcher grid's own arithmetic — a span of n cells is
  70n − 30 dp — so two cells is 110dp.

  resizeMode is none on purpose. The card is a square by design: its 64dp tile,
  its wave row and its transport are laid out for a square, and a cell that is
  taller than it is wide (two cells on a dense grid, or one stretched instance)
  used to leave a dead band between the seek bar and the buttons. The provider
  cannot resize its views at runtime, so the shape is fixed here instead.

  previewLayout is the real layout: its title and artist carry stand-in strings
  that a render overwrites, so the picker sees the full crystal card even
  though no provider has drawn the artwork or the glass yet. previewImage is
  the fallback for hosts below API 31, which don't inflate previewLayout at all.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_square_description"
    android:initialLayout="@layout/widget_media_compact"
    android:minHeight="110dp"
    android:minWidth="110dp"
    android:previewImage="@drawable/widget_preview_square"
    android:previewLayout="@layout/widget_media_compact"
    android:resizeMode="none"
    android:targetCellHeight="2"
    android:targetCellWidth="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
