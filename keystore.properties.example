# UMtify signs every build with the committed key at
# app/umtify-release.keystore so that CI and local APKs update an installed
# copy in place instead of being rejected as a different app.
#
#   alias:            umtify
#   store password:   umtify123
#   key password:     umtify123
#
# The key is intentionally public: this is a personal, self-distributed app,
# not something published under a private developer identity. Changing or
# losing it means the next APK cannot install over the existing one.
#
# The build no longer reads keystore.properties; this file remains only to
# point at the key described above.
